rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(data) {
      return isSignedIn() && (
        (data.memberIds is list && request.auth.uid in data.memberIds) ||
        (data.hostId is string && data.hostId == request.auth.uid) ||
        (data.ownerId is string && data.ownerId == request.auth.uid)
      );
    }

    function isJoiningSelf(existingData, nextData) {
      return isSignedIn() &&
        nextData.memberIds is list &&
        request.auth.uid in nextData.memberIds &&
        (
          !(existingData.memberIds is list) ||
          nextData.memberIds.hasAll(existingData.memberIds)
        ) &&
        nextData.hostId == existingData.hostId;
    }

    // Registered user profiles (Teacher / Student accounts) — strictly owner-only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Meetings & all classroom subcollections
    match /meetings/{meetingId} {
      // Single-document lookup by exact meeting ID (LEC-XXXX-XXXX) so any signed-in user or Guest can join
      allow get: if isSignedIn();

      // Collection queries MUST strictly filter by memberIds array-contains request.auth.uid
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Only authenticated users creating their own meeting with themselves in memberIds
      allow create: if isSignedIn() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds;

      // Members can update room state; joiners can append their own uid via arrayUnion
      allow update: if isMember(resource.data) || isJoiningSelf(resource.data, request.resource.data);

      // Only the host can delete a meeting
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{participantId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /signals/{signalId} {
        allow read, write: if isSignedIn();
      }

      match /whiteboard/{elementId} {
        allow read, write: if isSignedIn();
      }

      match /polls/{pollId} {
        allow read, write: if isSignedIn();
      }
    }

    // Standalone infinite whiteboards & elements
    match /whiteboards/{boardId} {
      // Single-document lookup for opening a shared class board
      allow get: if isSignedIn();

      // Collection queries MUST strictly filter by memberIds array-contains request.auth.uid
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Only authenticated users creating their own whiteboard with themselves in memberIds
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds;

      // Existing members can edit/sync, or a meeting participant can append themselves to memberIds
      allow update: if isMember(resource.data) || (
        isSignedIn() &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.ownerId == resource.data.ownerId
      );

      // Only the owner can delete a standalone whiteboard
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /elements/{elementId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
