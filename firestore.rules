rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(data) {
      return isSignedIn() && (
        (data.memberIds is list && request.auth.uid in data.memberIds) ||
        (data.hostId is string && data.hostId == request.auth.uid) ||
        (data.ownerId is string && data.ownerId == request.auth.uid)
      );
    }

    function isJoiningSelf(existingData, nextData) {
      return isSignedIn() &&
        nextData.memberIds is list &&
        request.auth.uid in nextData.memberIds &&
        (
          !(existingData.memberIds is list) ||
          nextData.memberIds.hasAll(existingData.memberIds)
        ) &&
        nextData.hostId == existingData.hostId;
    }

    // Registered user profiles (Teacher / Student accounts) — strictly owner-only
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Meetings & all classroom subcollections
    match /meetings/{meetingId} {
      // Single-document lookup, create, update, delete for any authenticated user (including Anonymous Guests)
      allow get, create, update, delete: if isSignedIn();

      // Collection queries MUST strictly filter by memberIds array-contains request.auth.uid
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      match /participants/{participantId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /signals/{signalId} {
        allow read, write: if isSignedIn();
      }

      match /whiteboard/{elementId} {
        allow read, write: if isSignedIn();
      }

      match /polls/{pollId} {
        allow read, write: if isSignedIn();
      }
    }

    // Standalone & in-meeting unified infinite whiteboards, elements & live presence
    match /whiteboards/{boardId} {
      // Single-document lookup, create, update, delete for any authenticated user
      allow get, create, update, delete: if isSignedIn();

      // Collection queries MUST strictly filter by memberIds array-contains request.auth.uid
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      match /elements/{elementId} {
        allow read, write: if isSignedIn();
      }

      match /presence/{uid} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
